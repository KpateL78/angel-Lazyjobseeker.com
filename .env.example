# Angel AI Meeting Assistant - environment configuration
# Copy this file to .env and fill in your own values. Never commit your real .env.

# Required: OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-replace-me

# Required: Path to a Google Cloud service account JSON with Speech-to-Text + TTS access.
# Can be absolute or relative to the project root.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Optional: default model used when the renderer first loads.
# One of: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
ANGEL_DEFAULT_MODEL=gpt-4o-mini

# Optional: default conversation preset.
# One of: general, interview, sales, standup, brainstorm
ANGEL_DEFAULT_PRESET=general
